{
  "name": "BreachMirror",
  "nodes": [
    {
      "id": "start-case",
      "name": "Start case",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        420
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "breachmirror",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "breachmirror-start"
    },
    {
      "id": "create-case",
      "name": "Create case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "http://checker:8000/cases",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ incident: $json.body.incident, target: $json.body.target, sample: Boolean($json.body.sample) }) }}",
        "options": {}
      }
    },
    {
      "id": "respond-with-case",
      "name": "Respond with case",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ id: $json.id, stamp: $json.stamp, stage: $json.stage }) }}",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "token-factory",
      "name": "Token Factory",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        720,
        40
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.NEBIUS_MODEL }}"
        },
        "responsesApiEnabled": false,
        "options": {
          "timeout": 120000,
          "temperature": 0.2
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "TOKEN_FACTORY_CREDENTIAL_ID",
          "name": "Token Factory"
        }
      }
    },
    {
      "id": "incident-investigator",
      "name": "Incident investigator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        720,
        280
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Incident: {{ $('Create case').item.json.incident }}\nCase id: {{ $('Create case').item.json.id }}",
        "options": {
          "systemMessage": "You reconstruct one documented security incident from pages Tavily retrieves during this case.\nDo not predict that a breach will occur. Do not write exploit steps, payloads, or reproduction instructions.\nSearch, then extract the primary pages you will cite. Look up ATLAS techniques and use only ids the lookup returns.\nKeep the Hugging Face account published 16 July 2026 and the OpenAI account published 26 August 2026 distinct when both appear.\nSeparate occurred dates from disclosed dates. If a date is not in the retrieved page, write \"Date unknown\".\nReturn JSON only. source_type for disclosure pages is Primary. Passages are short quotations from retrieved pages.\nShape:\n{\"summary_known\":\"\",\"summary_unknown\":\"\",\"open_questions\":[],\"sources\":[{\"ref\":\"01\",\"title\":\"\",\"url\":\"\",\"source_type\":\"Primary\",\"published\":null,\"retrieved\":\"2026-10-18\",\"passage\":\"\"}],\"timeline\":[{\"id\":\"\",\"title\":\"\",\"summary\":\"\",\"occurred\":\"Date unknown\",\"disclosed\":\"Date unknown\",\"status\":\"REPORTED\",\"source_refs\":[\"01\"]}]}\nAllowed status values: OBSERVED, REPORTED, INFERRED, CONTRADICTED, UNKNOWN, NOT OBSERVED.",
          "maxIterations": 8
        }
      }
    },
    {
      "id": "infrastructure-investigator",
      "name": "Infrastructure investigator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        720,
        560
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Target: {{ $('Create case').item.json.target }}\nCase id: {{ $('Create case').item.json.id }}\nCall the source-check tool once.",
        "options": {
          "systemMessage": "You inspect only the authorized target repository named in the user message.\nCall the source-check tool once. Do not claim a condition the tool did not return. Do not validate credentials or scan any other host.\nReturn JSON only: {\"scope\":\"\",\"observations\":[]} copying the tool's scope and observations.",
          "maxIterations": 3
        }
      }
    },
    {
      "id": "parse-incident",
      "name": "Parse incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        280
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json.output || '';\nconst start = raw.indexOf('{');\nconst end = raw.lastIndexOf('}');\nif (start < 0 || end < start) {\n  throw new Error('The agent did not return JSON.');\n}\nreturn [{ json: JSON.parse(raw.slice(start, end + 1)) }];"
      }
    },
    {
      "id": "store-incident",
      "name": "Store incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        280
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://checker:8000/cases/' + $('Create case').item.json.id + '/incident' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "parse-checks",
      "name": "Parse checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        560
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json.output || '';\nconst start = raw.indexOf('{');\nconst end = raw.lastIndexOf('}');\nif (start < 0 || end < start) {\n  throw new Error('The agent did not return JSON.');\n}\nreturn [{ json: JSON.parse(raw.slice(start, end + 1)) }];"
      }
    },
    {
      "id": "join-investigations",
      "name": "Join investigations",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1360,
        420
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      }
    },
    {
      "id": "threat-analyst",
      "name": "Threat analyst",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        1480,
        420
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Incident JSON:\n{{ JSON.stringify($('Parse incident').item.json) }}\n\nCheck JSON:\n{{ JSON.stringify($('Parse checks').item.json) }}\n\nCase id: {{ $('Create case').item.json.id }}\nTarget: {{ $('Create case').item.json.target }}",
        "options": {
          "systemMessage": "You compare an incident reconstruction with deterministic repository checks.\nUse the check status for each target condition. Do not upgrade it.\nFinding ids map to check ids:\nexposed-credentials = exposed_token_literal\nuntrusted-load = unpinned_pretrained\nagent-tools = write_or_network_tool\nauthorization = authorization_step\nisolation = isolation\nIf authorization_step is UNKNOWN, call the authorization-doc tool once. That is the only extra check you may run.\nYou may make one Tavily search if a material disclosure detail is still missing.\nDo not write exploit steps, payloads, or proof-of-concept code. Do not say the application is secure.\nEvery finding that is not UNKNOWN needs one Primary source ref and one Code or Documentation source ref.\nNOT OBSERVED findings must copy the inspected scope.\nrecommendation_limits must say that this does not establish that the application is secure.\nReturn JSON only with summary_known, summary_unknown, open_questions, recommendation, recommendation_limits, sources, timeline, findings.\nEach finding has id, prerequisite, observation, why_it_matters, limitations, next_check, status, scope, evidence_refs, atlas_ids, mitigation_ids, gap.\nAllowed status values: OBSERVED, REPORTED, INFERRED, CONTRADICTED, UNKNOWN, NOT OBSERVED.",
          "maxIterations": 4
        }
      }
    },
    {
      "id": "tavily-search",
      "name": "Tavily search",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        980,
        160
      ],
      "parameters": {
        "toolDescription": "Search the public web with Tavily. Arguments: query, and depth basic or advanced.",
        "method": "POST",
        "url": "http://checker:8000/tools/tavily/search",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ case_id: $('Create case').item.json.id, query: $fromAI('query', 'search query', 'string'), depth: $fromAI('depth', 'basic or advanced', 'string') }) }}"
      }
    },
    {
      "id": "tavily-extract",
      "name": "Tavily extract",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        980,
        280
      ],
      "parameters": {
        "toolDescription": "Extract text from https URLs already returned by Tavily search.",
        "method": "POST",
        "url": "http://checker:8000/tools/tavily/extract",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ case_id: $('Create case').item.json.id, urls: $fromAI('urls', 'https urls', 'string').split('\\n').filter(Boolean) }) }}"
      }
    },
    {
      "id": "atlas-lookup",
      "name": "ATLAS lookup",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        980,
        400
      ],
      "parameters": {
        "toolDescription": "Look up MITRE ATLAS techniques and mitigations by id or name.",
        "method": "GET",
        "url": "={{ 'http://checker:8000/atlas/search?case_id=' + $('Create case').item.json.id + '&q=' + encodeURIComponent($fromAI('query', 'technique or mitigation query', 'string')) }}",
        "options": {}
      }
    },
    {
      "id": "source-checks",
      "name": "Source checks",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        980,
        560
      ],
      "parameters": {
        "toolDescription": "Run deterministic checks on the authorized target. Does not read docs/.",
        "method": "POST",
        "url": "http://checker:8000/checks/run",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ case_id: $('Create case').item.json.id, target: $('Create case').item.json.target, include_docs: false }) }}"
      }
    },
    {
      "id": "authorization-docs",
      "name": "Authorization docs",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        1680,
        280
      ],
      "parameters": {
        "toolDescription": "Re-run the checks including docs/. Call only when authorization_step is UNKNOWN.",
        "method": "POST",
        "url": "http://checker:8000/checks/run",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ case_id: $('Create case').item.json.id, target: $('Create case').item.json.target, include_docs: true }) }}"
      }
    },
    {
      "id": "follow-up-search",
      "name": "Follow-up search",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        1680,
        400
      ],
      "parameters": {
        "toolDescription": "One Tavily search for a missing disclosure detail.",
        "method": "POST",
        "url": "http://checker:8000/tools/tavily/search",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ case_id: $('Create case').item.json.id, query: $fromAI('query', 'follow-up query', 'string'), depth: 'advanced' }) }}"
      }
    },
    {
      "id": "parse-report",
      "name": "Parse report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        420
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json.output || '';\nconst start = raw.indexOf('{');\nconst end = raw.lastIndexOf('}');\nif (start < 0 || end < start) {\n  throw new Error('The agent did not return JSON.');\n}\nreturn [{ json: JSON.parse(raw.slice(start, end + 1)) }];"
      }
    },
    {
      "id": "store-report",
      "name": "Store report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2080,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://checker:8000/cases/' + $('Create case').item.json.id + '/report' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
